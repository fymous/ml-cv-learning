INFERENCE_FPS=2.0
YOLO_MODEL=yolo11n.pt
YOLO_CONF_THRESHOLD=0.4
WORKER_MODE=once

# Tracker: botsort.yaml (ReID, stable IDs) or bytetrack.yaml (motion-only, cheaper)
TRACKER=botsort.yaml
# InsightFace pack for demographics: buffalo_l (accurate) or buffalo_s (lighter)
DEMOGRAPHICS_MODEL=buffalo_l

FEATURE_FOOTFALL=true
FEATURE_QUEUE=true
FEATURE_DEMOGRAPHICS=false
FEATURE_KIT=false
FEATURE_POSE=false
FEATURE_GROUP=true

# Exclude guards/staff/passers-by from the count (uses `staff`/`exclude` zones).
FEATURE_STAFF_FILTER=true
# Optional staff-uniform HSV ranges (OpenCV HSV) as JSON. Empty = zones only.
# Example (blue-ish uniform): STAFF_UNIFORM_HSV='[[90,60,40,130,255,255]]'
STAFF_UNIFORM_HSV=[]
