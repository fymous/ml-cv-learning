INFERENCE_FPS=2.0
YOLO_MODEL=yolo11n.pt
YOLO_CONF_THRESHOLD=0.4
WORKER_MODE=once

# Tracker: botsort.yaml (ReID, stable IDs) or bytetrack.yaml (motion-only, cheaper)
TRACKER=botsort.yaml
# InsightFace pack for demographics: buffalo_l (accurate) or buffalo_s (lighter)
DEMOGRAPHICS_MODEL=buffalo_l

FEATURE_FOOTFALL=true
FEATURE_QUEUE=true
FEATURE_DEMOGRAPHICS=false
FEATURE_KIT=false
FEATURE_POSE=false
FEATURE_GROUP=true

# Exclude guards/staff/passers-by from the count (uses `staff`/`exclude` zones).
FEATURE_STAFF_FILTER=true
# Optional staff-uniform HSV ranges (OpenCV HSV) as JSON. Empty = zones only.
# Example (blue-ish uniform): STAFF_UNIFORM_HSV='[[90,60,40,130,255,255]]'
STAFF_UNIFORM_HSV=[]

# Time-in-zone browsing dwell (uses `dwell`-type zones, independent of
# footfall). Safe no-op if no `dwell` zone is drawn.
FEATURE_DWELL=true
# Minimum seconds someone must stay in a dwell zone to be flagged/counted at
# all. Shorter stays (a brief walk-through) are silently ignored.
DWELL_MIN_SEC=4.0

# Customer attendance / unattended alerting (uses `service`-type zones; needs
# FEATURE_STAFF_FILTER on to identify staff). Safe no-op without a service zone.
FEATURE_ATTENDANCE=true
# Staff within this many metres of a customer counts as attending them.
ATTEND_PROXIMITY_M=1.5
# Cumulative seconds of staff proximity before a customer is latched attended.
ATTEND_MIN_SEC=2.0
# Seconds a customer waits with no staff before one unattended alert fires.
UNATTENDED_ALERT_SEC=5.0

# Path to a learned staff profile (staff_profile.json), produced by onboarding
# (staff stand in an `enroll` zone → uniform colour is learned). Its HSV ranges
# are merged into the staff filter so staff are recognised by uniform anywhere.
STAFF_PROFILE_PATH=
